page {
  width: 100%;
  height: 100%;
  background: #1e1a16;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

view, scroll-view, button, image {
  box-sizing: border-box;
}

button::after {
  border: none;
}
